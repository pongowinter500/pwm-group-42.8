{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "course"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "CourseName": {
      "type": "string",
      "maxLength": 255,
      "required": true,
      "unique": true
    },
    "CourseTitle": {
      "type": "string",
      "maxLength": 255,
      "required": true
    },
    "CourseSubtitle": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "catalogueDescription": {
      "type": "text",
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "level": {
      "type": "enumeration",
      "required": true,
      "default": "Beginner",
      "enum": [
        "Beginner",
        "Intermidiate",
        "Advanced"
      ]
    },
    "category": {
      "type": "string"
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "isNew": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "section1Title": {
      "type": "string",
      "required": true
    },
    "section1Text": {
      "type": "text",
      "required": true
    },
    "text": {
      "type": "component",
      "component": "course-attributes.topic",
      "repeatable": false,
      "required": true
    },
    "instructor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::instructor.instructor"
    },
    "section2Title": {
      "type": "string",
      "required": true
    }
  }
}
